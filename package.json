{
	"name": "vexis-dlmm-bot",
	"version": "0.1.0",
	"description": "CLI to view Meteora DLMM portfolio (open & closed positions)",
	"type": "module",
	"packageManager": "bun@1.4.1",
	"bin": {
		"vexis": "./dist/cli.js"
	},
	"workspaces": [
		"src/web-react"
	],
	"scripts": {
		"postinstall": "bun scripts/patch-cjs.cjs",
		"build": "tsc && bun run --filter web-react build",
		"dev": "bun run --filter web-react dev",
		"start": "bun run --filter web-react start",
		"cli": "bun src/cli.ts",
		"bot": "bun src/telegram/bot.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint",
		"format": "biome format",
		"check": "biome check --write"
	},
	"dependencies": {
		"@ai-sdk/openai-compatible": "^3.0.27",
		"@coral-xyz/anchor": "0.31.1",
		"@effect/cli": "^0.76.0",
		"@effect/platform": "^0.97.0",
		"@effect/platform-node": "^0.108.0",
		"@effect/printer": "^0.50.0",
		"@effect/printer-ansi": "^0.50.0",
		"@meteora-ag/dlmm": "^1.9.10",
		"@meteora-ag/zap-sdk": "^1.3.1",
		"@solana/spl-token": "^0.4.14",
		"@solana/web3.js": "^1.98.4",
		"ai": "^7.0.58",
		"effect": "^3.22.0",
		"grammy": "^1.44.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"@effect/vitest": "^0.30.0",
		"@types/bn.js": "^5.2.0",
		"@types/bs58": "^4.0.4",
		"@types/node": "^22.10.0",
		"typescript": "^5.7.2",
		"vite": "^8.2.2",
		"vitest": "^3.2.7"
	}
}
